# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Server
PORT=3000

# Admin credentials (CHANGE THESE IN PRODUCTION!)
ADMIN_USER=admin
ADMIN_PASSWORD=change_this_strong_password_here

# CORS - comma-separated list of allowed origins (leave empty for development)
CORS_ORIGINS=https://yourdomain.com

# Database SSL - set to 'false' only for managed DB services that require it (e.g., Render)
DB_SSL_REJECT_UNAUTHORIZED=false
